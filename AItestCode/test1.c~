#include <stdio.h>
#include <stdlib.h>
#include <png.h>

int copy_png(const char *input_filename, const char *output_filename) {
    FILE *infile = fopen(input_filename, "rb");
    if (!infile) {
        perror("Ошибка открытия исходного файла");
        return -1;
    }

    // 1. Проверка сигнатуры PNG
    unsigned char header[8];
    if (fread(header, 1, 8, infile) != 8 || png_sig_cmp(header, 0, 8)) {
        fprintf(stderr, "Файл %s не является корректным PNG\n", input_filename);
        fclose(infile);
        return -1;
    }

    // 2. Инициализация структур для чтения
    png_structp png_ptr = png_create_read_struct(PNG_LIBPNG_VER_STRING, NULL, NULL, NULL);
    if (!png_ptr) {
        fclose(infile);
        return -1;
    }

    png_infop info_ptr = png_create_info_struct(png_ptr);
    if (!info_ptr) {
        png_destroy_read_struct(&png_ptr, NULL, NULL);
        fclose(infile);
        return -1;
    }

    // Обработка ошибок libpng (аналог try-catch)
    if (setjmp(png_jmpbuf(png_ptr))) {
        png_destroy_read_struct(&png_ptr, &info_ptr, NULL);
        fclose(infile);
        return -1;
    }

    // Связываем файл со структурой чтения
    png_init_io(png_ptr, infile);
    // Сообщаем, что первые 8 байт (сигнатура) уже прочитаны
    png_set_sig_bytes(png_ptr, 8);

    // Читаем всю информацию о файле и сами пиксели
    png_read_png(png_ptr, info_ptr, PNG_TRANSFORM_IDENTITY, NULL);

    // Получаем указатели на строки с пикселями
    png_bytepp row_pointers = png_get_rows(png_ptr, info_ptr);

    // 3. Инициализация структур для записи
    FILE *outfile = fopen(output_filename, "wb");
    if (!outfile) {
        perror("Ошибка создания нового файла");
        png_destroy_read_struct(&png_ptr, &info_ptr, NULL);
        fclose(infile);
        return -1;
    }

    png_structp write_ptr = png_create_write_struct(PNG_LIBPNG_VER_STRING, NULL, NULL, NULL);
    if (!write_ptr) {
        fclose(outfile);
        png_destroy_read_struct(&png_ptr, &info_ptr, NULL);
        fclose(infile);
        return -1;
    }

    png_infop write_info_ptr = png_create_info_struct(write_ptr);
    if (!write_info_ptr) {
        png_destroy_write_struct(&write_ptr, NULL);
        fclose(outfile);
        png_destroy_read_struct(&png_ptr, &info_ptr, NULL);
        fclose(infile);
        return -1;
    }

    // Обработка ошибок записи
    if (setjmp(png_jmpbuf(write_ptr))) {
        png_destroy_write_struct(&write_ptr, &write_info_ptr);
        fclose(outfile);
        png_destroy_read_struct(&png_ptr, &info_ptr, NULL);
        fclose(infile);
        return -1;
    }

    // Связываем новый файл со структурой записи
    png_init_io(write_ptr, outfile);

    // Переносим параметры изображения (ширина, высота, глубина цвета и т.д.)
    png_uint_32 width, height;
    int bit_depth, color_type, interlace_type, compression_type, filter_type;
    
    png_get_IHDR(png_ptr, info_ptr, &width, &height, &bit_depth, &color_type,
                 &interlace_type, &compression_type, &filter_type);
                 
    png_set_IHDR(write_ptr, write_info_ptr, width, height, bit_depth, color_type,
                 interlace_type, compression_type, filter_type);

    // Устанавливаем указатели на строки для записи
    png_set_rows(write_ptr, write_info_ptr, row_pointers);

    // Записываем данные в новый файл
    png_write_png(write_ptr, write_info_ptr, PNG_TRANSFORM_IDENTITY, NULL);

    // 4. Очистка ресурсов
    png_destroy_write_struct(&write_ptr, &write_info_ptr);
    fclose(outfile);
    png_destroy_read_struct(&png_ptr, &info_ptr, NULL);
    fclose(infile);

    return 0;
}

int main() {
    const char *input = "input.png";
    const char *output = "output.png";

    printf("Копирование %s в %s...\n", input, output);
    if (copy_png(input, output) == 0) {
        printf("Успешно скопировано!\n");
    } else {
        fprintf(stderr, "Произошла ошибка при обработке файла.\n");
    }

    return 0;
}
